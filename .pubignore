# Publishing-only excludes. When this file exists pub uses it INSTEAD of
# .gitignore, so it has to repeat those entries too.
.dart_tool/
build/
coverage/
pubspec.lock
doc/api/

# The generator and its 8 MB vendored OpenAPI spec are build-time inputs. They
# live in the repository, but shipping them would put 8 MB of JSON into every
# consumer's pub cache for no runtime benefit.
tool/
